# Supabase, Project Settings > API Keys.
#
# Newer projects show these as "Project URL" and a "Publishable key" that starts
# with sb_publishable_. Older ones call the same key "anon public" and it looks
# like a JWT. Either works here; the variable name below is the one Supabase's
# own tooling expects, so it has not been renamed.
#
# Both values are safe in the browser. The publishable key can only do what the
# row level security policies in supabase/schema.sql allow.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_your-key

# The secret key (sb_secret_..., previously service_role) is NOT used by this
# app and must never be committed or put in a NEXT_PUBLIC_ variable. It bypasses
# every policy. If one is ever pasted somewhere it should not be, revoke it in
# Project Settings > API Keys rather than hoping nobody saw it.
