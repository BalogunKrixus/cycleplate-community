# Supabase project settings, Project Settings > API.
# Both of these are safe in the browser: the anon key only works within the
# limits of the row level security policies in supabase/schema.sql.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# The service_role key is NOT used by this app and must never be committed or
# put in a NEXT_PUBLIC_ variable. It bypasses every policy.
